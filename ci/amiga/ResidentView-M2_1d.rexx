/* AmiForensics M2.1d ResidentView ARexx qualification */
OPTIONS RESULTS

ADDRESS 'RESIDENTVIEW'
'PING'
IF RC ~= 0 THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=PING'
  SAY 'RC='RC
  EXIT 20
END
IF RESULT ~= 'PONG' THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=PING_RESULT'
  SAY 'RESULT='RESULT
  EXIT 20
END
SAY 'PING=PONG'

'LIST RESIDENTS'
IF RC ~= 0 THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=LIST_RESIDENTS'
  SAY 'RC='RC
  EXIT 20
END
IF POS('record_count=', RESULT) = 0 THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=LIST_RESIDENTS_RESULT'
  SAY 'RESULT='RESULT
  EXIT 20
END
SAY 'LIST_RESIDENTS=PASS'
SAY RESULT

'QUIT'
IF RC ~= 0 THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=QUIT'
  SAY 'RC='RC
  EXIT 20
END
IF RESULT ~= 'BYE' THEN DO
  SAY 'STATUS=FAIL'
  SAY 'STEP=QUIT_RESULT'
  SAY 'RESULT='RESULT
  EXIT 20
END
SAY 'QUIT=BYE'
SAY 'STATUS=PASS'
SAY 'GATE=M2_1D_RESIDENTVIEW_AREXX_RUNTIME'
EXIT 0
